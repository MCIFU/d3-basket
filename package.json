{
  "name": "d3-basket",
  "version": "0.1.0",
  "description": "d3 basket: resultados, estadísticas y trayectorias del baloncesto español y europeo (web estática)",
  "author": "MCIFU",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.site.json",
    "test": "vitest run",
    "scrape": "tsx src/cli/index.ts",
    "scrape:acb": "tsx src/cli/index.ts sync acb",
    "export:web": "tsx src/cli/index.ts export-web",
    "build:site": "bash tools/actualizar.sh diaria",
    "build:site:semanal": "bash tools/actualizar.sh semanal",
    "seed": "tsx src/cli/index.ts export-web seed/d3basket.db.gz",
    "site:data": "node --max-old-space-size=6144 --import tsx tools/site/export.ts --db data/d3basket.db --out public/d",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "site:smoke": "node tools/site/smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
