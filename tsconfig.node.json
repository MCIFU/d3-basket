{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "out/.tsc-node"
  },
  "include": ["src/db/**/*", "src/scraper/**/*", "src/cli/**/*", "src/shared/**/*", "tests/**/*", "tools/site/**/*.ts", "site/src/lib/bucket.ts", "site/src/lib/countries.ts", "site/src/lib/color.ts", "site/src/lib/fmt.ts", "site/src/lib/data.ts", "site/src/lib/stats.ts", "vite.site.config.ts", "vitest.config.ts"]
}
